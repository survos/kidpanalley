{% extends 'base.html.twig' %}

{% block page_title 'KPA' %}
{% block page_subtitle 'KPA Dashboard' %}

{% block body %}
    {% if app.user %}
        <div class="mb-3">
            <div class="text-muted small">Signed in as</div>
            <div class="fw-semibold">{{ app.user.userIdentifier }}</div>

            {# If you truly need all identifiers, make sure identifiers is iterable in your User implementation #}
            {% if app.user.identifiers is defined %}
                <pre class="mt-2 small text-muted">{{ app.user.identifiers|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
            {% endif %}
        </div>
    {% endif %}

    {% set workspace = defaultWorkspace|default('default') %}

    <div class="mt-4 d-flex gap-2">
        <a href="/api/songs/export.csv" class="btn btn-outline-success" download>
            {{ ux_icon('tabler:file-download')|raw }} Download Song CSV
        </a>
        <a href="/api/file-assets/export.csv" class="btn btn-outline-success" download>
            {{ ux_icon('tabler:file-download')|raw }} Download Files CSV
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3 mt-4">
        {% for entity in dashboardEntities %}
            <div class="col">
                <twig:card>
                    <twig:block name="card_body">
                        <div class="d-flex align-items-start gap-3">
                            <div class="fs-1 lh-1 text-primary">{{ ux_icon(entity.icon)|raw }}</div>
                            <div>
                                <div class="text-light small fw-semibold">{{ entity.label }}</div>
                                <div class="display-6 fw-bold">{{ entity.count|number_format }}</div>
                                <div class="mt-2 text-muted small">{{ entity.description }}</div>
                            </div>
                        </div>
                    </twig:block>

                    <twig:block name="links">
                        <div class="d-grid gap-2">
                            <a href="{{ path(entity.gridRoute) }}" class="btn btn-info btn-lg fw-bold">
                                API Grid
                            </a>
                            <a href="{{ path('meili_insta', { indexName: entity.meiliIndex }) }}" class="btn btn-primary btn-lg fw-bold">
                                Meili Search
                            </a>
                            <a href="{{ path('meili_chat', { indexName: entity.meiliIndex, workspace: workspace }) }}" class="btn btn-outline-secondary">
                                Chat
                            </a>
                        </div>
                    </twig:block>
                </twig:card>
            </div>
        {% endfor %}
    </div>

{% endblock %}
