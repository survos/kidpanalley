{% extends 'base.html.twig' %}

{% block title %}File Assets{% endblock %}
{% block page_title %}File Assets{% endblock %}

{% block body %}
    {% set columns = [
        col(name: 'filename'),
        col(name: 'school', sortable: true),
        col(name: 'year', sortable: true),
        col(name: 'type', title: 'filetype', browsable: true, sortable: true),
        col(name: 'extension', sortable: true),
        col(name: 'mimeType', title: 'mime-type'),
        col(name: 'size', sortable: true),
        col(name: 'modifiedTime', title: 'modified', sortable: true),
        col(name: 'isReadable', title: 'readable', sortable: true, searchable: false),
        col(name: 'duration', sortable: true),
        col(name: 'dirname'),
        col(name: 'relativePath', title: 'path'),
    ] %}

    <twig:api_grid
        :class="class"
        :apiGetCollectionUrl="api_route(class)"
        :columns="columns"
        :caller="_self"
        :searchPanes="true"
        :dom="'PBQlfrtp'"
        :columnControl="true"
    >
        <twig:block name="size">
            {{ row.size is not empty ? row.size|number_format(0, '.', ',') : '' }}
        </twig:block>

        <twig:block name="modifiedTime">
            {{ row.modifiedTime ? row.modifiedTime|date('Y-m-d H:i') : '' }}
        </twig:block>

        <twig:block name="duration">
            {{ row.duration is not empty ? row.duration|number_format(2, '.', ',') : '' }}
        </twig:block>

        <twig:block name="relativePath">
            <span class="d-inline-block text-truncate" style="max-width: 420px;" title="{{ row.relativePath }}">
                {{ row.relativePath }}
            </span>
        </twig:block>
    </twig:api_grid>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (() => {
            let tries = 0;
            const maxTries = 40;
            const timer = window.setInterval(() => {
                tries += 1;

                const sidebar = document.querySelector('.dtsp-verticalPanes');
                const container = document.querySelector('.dtsp-searchPanes');

                if (!sidebar || !container) {
                    if (tries >= maxTries) {
                        window.clearInterval(timer);
                    }
                    return;
                }

                if (!sidebar.contains(container)) {
                    sidebar.append(container);
                }

                window.clearInterval(timer);
            }, 150);
        })();
    </script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .dtsp-searchPanes {
            --dtsp-count-bg: #64748b;
            --dtsp-count-bg-active: #334155;
        }

        .dtsp-searchPanes .dtsp-name {
            color: #0f172a !important;
        }

        .dtsp-searchPanes .dtsp-pill,
        .dtsp-searchPanes .dtsp-pill:hover {
            color: #0f172a !important;
        }

        .dtsp-searchPanes .dtsp-pill .dtsp-pillInner,
        .dtsp-searchPanes .dtsp-pill .dtsp-count,
        .dtsp-searchPanes .dtsp-pill .dtsp-countColumn {
            color: #fff !important;
            background-color: var(--dtsp-count-bg) !important;
            font-weight: 700 !important;
            opacity: 1 !important;
            font-size: 0.85rem !important;
            line-height: 1.1 !important;
            min-width: 2.4rem !important;
            padding-inline: 0.5rem !important;
            text-align: center !important;
        }

        .dtsp-searchPanes .dtsp-countColumn,
        .dtsp-searchPanes .dtsp-countColumn * {
            color: #fff !important;
            text-shadow: none !important;
            opacity: 1 !important;
        }

        .dtsp-searchPanes .dtsp-pill.dtsp-selected .dtsp-pillInner,
        .dtsp-searchPanes .dtsp-pill.dtsp-selected .dtsp-count,
        .dtsp-searchPanes .dtsp-pill.dtsp-selected .dtsp-countColumn {
            background-color: var(--dtsp-count-bg-active) !important;
            color: #fff !important;
        }
    </style>
{% endblock %}
