{% extends 'base.html.twig' %}

{% block page_title 'Audio' %}

{% block body %}
    {% set columns = [
        col(name: 'title'),
        col(name: 'format', browsable: true, sortable: true),
        col(name: 'variant', browsable: true, sortable: true),
        col(name: 'size', sortable: true),
        col(name: 'marking', browsable: true, sortable: true),
    ] %}

    <twig:api_grid
        :class="class"
        :apiGetCollectionUrl="path(constant(class ~ '::DOCTRINE_ROUTE'))"
        :columns="columns"
        :caller="_self"
        :searchPanes="false"
        :columnControl="true"
    >
        <twig:block name="title">
            <a href="{{ path('audio_show', { id: row.id }) }}">{{ row.title }}</a>
        </twig:block>

        <twig:block name="size">
            {{ row.size is not empty ? row.size|number_format(0, '.', ',') : '' }}
        </twig:block>
    </twig:api_grid>
{% endblock %}
