{% extends 'base.html.twig' %}

{% block page_title song.title %}
{% block page_subtitle song.school ~ (song.year ? ', ' ~ song.year : '') %}

{% block body %}
    <div class="row mb-4">
        <div class="col-lg-7">
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h3 class="card-title mb-0">Audio Recordings</h3>
                    {% if audios|length %}
                        <span class="badge bg-blue">{{ audios|length }}</span>
                    {% endif %}
                </div>
                <div class="card-body">
                    {% if audios|length %}
                        {% for audio in audios %}
                            <div class="{% if not loop.last %}mb-3 border-bottom pb-3{% endif %}">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div>
                                        <a href="{{ path('audio_show', { id: audio.id }) }}" class="fw-semibold">{{ audio.title }}</a>
                                        {% if audio.variant %}<span class="text-muted ms-1">{{ audio.variant }}</span>{% endif %}
                                    </div>
                                    <span class="badge bg-secondary">{{ audio.format }}</span>
                                </div>
                                <audio controls preload="none" style="width: 100%;">
                                    <source src="{{ path('audio_file', { id: audio.id }) }}" type="audio/mpeg">
                                </audio>
                                {% if audio.fileAsset %}
                                    <div class="text-muted small mt-1">
                                        <code>{{ audio.fileAsset.filename }}</code>
                                        {% if audio.fileAsset.size %}
                                            &middot; {{ (audio.fileAsset.size / 1048576)|number_format(1) }} MB
                                        {% endif %}
                                        {% if audio.fileAsset.duration %}
                                            &middot; {{ (audio.fileAsset.duration / 60)|round(0, 'floor') }}:{{ '%02d'|format(audio.fileAsset.duration % 60) }}
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    {% else %}
                        <span class="text-muted">No audio recordings yet.</span>
                    {% endif %}
                </div>
            </div>

            {% if songLyrics|length %}
                <div class="card mb-4">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h3 class="card-title mb-0">Lyric Documents</h3>
                        <span class="badge bg-blue">{{ songLyrics|length }}</span>
                    </div>
                    <div class="list-group list-group-flush">
                        {% for link in songLyrics %}
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <code>{{ link.fileAsset.filename }}</code>
                                    <span class="badge bg-secondary">{{ link.fileAsset.extension }}</span>
                                </div>
                                {% if link.sourceTitle %}
                                    <div class="text-muted small">Matched title: {{ link.sourceTitle }}</div>
                                {% endif %}
                                {% if link.fileAsset.relativePath %}
                                    <div class="text-muted small">{{ link.fileAsset.relativePath }}</div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if relatedFiles|length %}
                <div class="card mb-4">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h3 class="card-title mb-0">All Source Files</h3>
                        <span class="badge bg-blue">{{ relatedFiles|length }}</span>
                    </div>
                    <div class="list-group list-group-flush">
                        {% for file in relatedFiles %}
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <code>{{ file.filename }}</code>
                                    {% if file.relativePath %}
                                        <div class="text-muted small">{{ file.relativePath }}</div>
                                    {% endif %}
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-secondary">{{ file.extension }}</span>
                                    {% if file.size %}
                                        <div class="text-muted small">{{ (file.size / 1048576)|number_format(1) }} MB</div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="col-lg-5">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">Lyrics</h3>
                </div>
                <div class="card-body" style="max-height: 70vh; overflow: auto;">
                    {% if song.lyrics %}
                        <twig:Lyrics text="{{ song.lyrics }}" />
                    {% else %}
                        <span class="text-muted">No lyrics yet.</span>
                    {% endif %}
                </div>
            </div>

            {% if song.videos|length %}
                <div class="card mb-4">
                    <div class="card-header">
                        <h3 class="card-title mb-0">Videos</h3>
                    </div>
                    <div class="card-body">
                        {% for video in song.videos %}
                            <div class="ratio ratio-16x9 {% if not loop.last %}mb-3{% endif %}">
                                <iframe src="https://www.youtube.com/embed/{{ video.youtubeId }}" allowfullscreen loading="lazy"></iframe>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title mb-0">Song Details</h3>
        </div>
        <table class="table table-sm mb-0">
            <tbody>
                {% if song.writers %}<tr><th style="width: 12rem;">Writers</th><td>{{ song.writers }}</td></tr>{% endif %}
                {% if song.publisher %}<tr><th style="width: 12rem;">Publisher</th><td>{{ song.publisher }}</td></tr>{% endif %}
                {% if song.school %}<tr><th style="width: 12rem;">School</th><td>{{ song.school }}</td></tr>{% endif %}
                {% if song.date %}<tr><th style="width: 12rem;">Date</th><td>{{ song.date|date('Y-m-d') }}</td></tr>{% endif %}
                {% if song.year and not song.date %}<tr><th style="width: 12rem;">Year</th><td>{{ song.year }}</td></tr>{% endif %}
                {% if song.featuredArtist %}<tr><th style="width: 12rem;">Featured Artist</th><td>{{ song.featuredArtist }}</td></tr>{% endif %}
                {% if song.recording %}<tr><th style="width: 12rem;">Recording</th><td>{{ song.recording }}</td></tr>{% endif %}
                {% if song.recordingCredits %}<tr><th style="width: 12rem;">Recording Credits</th><td>{{ song.recordingCredits }}</td></tr>{% endif %}
                {% if song.musicians %}<tr><th style="width: 12rem;">Musicians</th><td>{{ song.musicians }}</td></tr>{% endif %}
                {% if song.description %}<tr><th style="width: 12rem;">Description</th><td>{{ song.description }}</td></tr>{% endif %}
                {% set notesData = song.notes ? song.notes : {} %}
                {% if notesData is iterable and notesData|length %}
                    {% for k, v in notesData %}
                        {% if v %}
                            <tr><th style="width: 12rem;" class="text-muted">{{ k }}</th><td class="small">{{ v }}</td></tr>
                        {% endif %}
                    {% endfor %}
                {% endif %}
                <tr><th style="width: 12rem;">ID</th><td><code>{{ song.id }}</code></td></tr>
            </tbody>
        </table>
    </div>
{% endblock %}
