{% extends 'base.html.twig' %}

{% block page_title song.title %}
{% block page_subtitle song.school ~ ', ' ~ song.year %}

{% block body %}
    <div class="row">
    <div class="col-md-6">
        {% for video in song.videos %}
            <object width="420" height="315"
                    data="https://www.youtube.com/embed/{{ video.youtubeId }}">
            </object>
        {% endfor %}
    </div>
    <div class="col-md-6">
        {# reused accordion? #}
        {{ component('cards:tabs', { active: 'profile',
            tabs: [
                tab('profile', '@profile data', translationDomain='fosUserBundle'),
                tab('school', content=song.school),
            ] }) }}
    </div>
</div>


    <twig:divider />

    <h1>{{ song.title }} ({{ song.school }}, {{ song.year }})</h1>
    {% if audios|length %}
        <div class="mb-3">
            <a href="{{ path('audio_show', { id: audios|first.id }) }}" class="btn btn-outline-primary">
                Open First Audio
            </a>
        </div>
    {% endif %}

    {# Lyrics — rendered from the ChordPro source in song.lyrics #}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Lyrics</h3>
                </div>
                <div class="card-body">
                    {% if song.lyrics %}
                        <twig:Lyrics text="{{ song.lyrics }}" />
                    {% else %}
                        <span class="text-muted">No lyrics yet.</span>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Metadata — only show fields with values, in info-density order. #}
    {% set notesData = song.notes ? song.notes : {} %}
    <table class="table table-sm">
        <tbody>
            <tr>
                <th style="width: 12rem;">Id</th>
                <td><code>{{ song.id }}</code></td>
            </tr>
            <tr><th>Title</th><td>{{ song.title }}</td></tr>
            {% if song.writers %}<tr><th>Writers</th><td>{{ song.writers }}</td></tr>{% endif %}
            {% if song.publisher %}<tr><th>Publisher</th><td>{{ song.publisher }}</td></tr>{% endif %}
            {% if song.school %}<tr><th>School</th><td>{{ song.school }}</td></tr>{% endif %}
            {% if song.date %}<tr><th>Date</th><td>{{ song.date|date('Y-m-d') }}</td></tr>{% endif %}
            {% if song.year and not song.date %}<tr><th>Year</th><td>{{ song.year }}</td></tr>{% endif %}
            {% if song.featuredArtist %}<tr><th>Featured Artist</th><td>{{ song.featuredArtist }}</td></tr>{% endif %}
            {% if song.recording %}<tr><th>Recording</th><td>{{ song.recording }}</td></tr>{% endif %}
            {% if song.recordingCredits %}<tr><th>Recording Credits</th><td>{{ song.recordingCredits }}</td></tr>{% endif %}
            {% if song.musicians %}<tr><th>Musicians</th><td>{{ song.musicians }}</td></tr>{% endif %}

            {% if audios|length %}
                <tr>
                    <th>Audio</th>
                    <td>
                        <ul class="list-unstyled mb-0">
                            {% for audio in audios %}
                                <li>
                                    <a href="{{ path('audio_show', { id: audio.id }) }}">
                                        {{ audio.title }} ({{ audio.format }})
                                    </a>
                                    {% if audio.variant %}<span class="text-muted">- {{ audio.variant }}</span>{% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </td>
                </tr>
            {% endif %}

            {% if relatedFiles|length %}
                <tr>
                    <th>Related Files</th>
                    <td>
                        <ul class="list-unstyled mb-0">
                            {% for file in relatedFiles %}
                                <li>
                                    <code>{{ file.filename }}</code>
                                    <span class="text-muted">({{ file.type }}, {{ file.extension }})</span>
                                    {% if file.relativePath %}<div class="small text-muted">{{ file.relativePath }}</div>{% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </td>
                </tr>
            {% endif %}

            {% if songLyrics|length %}
                <tr>
                    <th>Lyrics Sources</th>
                    <td>
                        <ul class="list-unstyled mb-0">
                            {% for link in songLyrics %}
                                <li>
                                    <code>{{ link.fileAsset.filename }}</code>
                                    {% if link.sourceTitle %}<span class="text-muted">→ {{ link.sourceTitle }}</span>{% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </td>
                </tr>
            {% endif %}

            {# notes column carries the original CSV row as JSON — flatten it inline. #}
            {% if notesData is iterable and notesData|length %}
                {% for k, v in notesData %}
                    {% if v %}
                        <tr>
                            <th class="text-muted small">{{ k }}</th>
                            <td class="small">{{ v }}</td>
                        </tr>
                    {% endif %}
                {% endfor %}
            {% endif %}
            <tr>
                <th>Publisher</th>
                <td>{{ song.publisher }}</td>
            </tr>
{#            <tr>#}
{#                <th>Notes</th>#}
{#                <td>{{ song.notes }}</td>#}
{#            </tr>#}
        </tbody>
    </table>
{% endblock %}
