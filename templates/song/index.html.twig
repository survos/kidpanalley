{% extends 'base.html.twig' %}

{% block title %}Song index{% endblock %}

{% block PAGE_MENU %}
    {% set options = {
        entityClass: class
    } %}
    <twig:menu :type="PAGE_MENU" :caller="_self" :options="options">
    </twig:menu>

{% endblock %}


{% block body %}
    {% set columns = [
        col(name: 'title', responsive_priority: 1),
        col(name: 'school', searchable: true, sortable: true, browsable: true, width: '13rem', responsive_priority: 2),
        col(name: 'year', searchable: false, sortable: true, browsable: true, width: '9rem', responsive_priority: 3),
        col(name: 'videos', width: '5rem', responsive_priority: 30),
        col(name: 'publishersArray', title: 'publishers', responsive_priority: 40),
        col(name: 'writers', responsive_priority: 50),
        col(name: 'code', responsive_priority: 60),
    ] %}

    <twig:api_grid
            :class="class"
            :apiGetCollectionUrl="api_route(class)"
            :caller="_self"
            :columns="columns"
            :searchPanes="false"
            :columnControl="true"
    >

        <twig:block name="writersArray">
            {{ row.writersArray|join('|') }}
        </twig:block>

        <twig:block name="publishersArray">
            {{ row.publishersArray|join('<br />')|raw }}
        </twig:block>

        <twig:block name="videos">
            {% for video in row.videos %}
                <a target="_blank" href="http://www.youtube.com/watch?v={{ video.youtubeId }}">
                    <img src="{{ video.thumbnailUrl }}" height="60"/>
                </a>
            {% endfor %}
        </twig:block>

        <twig:block name="title">
            <span class="d-inline-block text-truncate" style="max-width: 300px;" title="{{ row.title }}">
                <a href="{{ path('song_show', row.rp) }}">{{ row.title }}</a>
            </span>
        </twig:block>
        <twig:block name="youtubeId">

            <a href="{{ path('song_show', row.rp) }}">{{ row.title }}</a>
            {% if row.youtubeId|default(false) %}
                <a target="_blank" href="http://www.youtube.com/watch?v={{ row.youtubeId }}">{{ row.youtubeId }}</a>
            {% endif %}
        </twig:block>

    </twig:api_grid>



{% endblock %}
