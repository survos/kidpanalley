{
    "name": "tacman/kpa",
    "description": "Archives for Kid Pan Alley",
    "keywords": [
        "symfony"
    ],
    "license": "proprietary",
    "type": "project",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-sqlite3": "*",
        "ext-xml": "*",
        "ext-zip": "*",
        "api-platform/core": "^4.3.x-dev",
        "doctrine/doctrine-bundle": "^3.2.4",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.7",
        "easycorp/easyadmin-bundle": "^5.1",
        "friendsofsymfony/jsrouting-bundle": "^3.6.1",
        "google/apiclient": "^2.19.4",
        "inspector-apm/inspector-symfony": "^1.11.5",
        "intelektron/chordpro-php": "^1.1.1",
        "league/csv": "^9.28",
        "league/flysystem-aws-s3-v3": "^3.35.1",
        "league/oauth2-facebook": "^2.2",
        "league/oauth2-github": "^3.1.1",
        "league/oauth2-google": "^5.0",
        "liquid/liquid": "^1.4.45",
        "meilisearch/meilisearch-php": "dev-main",
        "nelmio/cors-bundle": "^2.6.1",
        "paragonie/sodium_compat": "^2.5",
        "phpoffice/phpspreadsheet": "^5.8",
        "phpoffice/phpword": "^1.4",
        "sentry/sentry-symfony": "^5.10.0",
        "spatie/flysystem-dropbox": "^3.1.0",
        "stevenmaguire/oauth2-dropbox": "^3.1",
        "survos/admin-bundle": "^2.10.19",
        "survos/api-grid-bundle": "^2.10.19",
        "survos/auth-bundle": "^2.10.19",
        "survos/ciine-bundle": "^2.10.19",
        "survos/command-bundle": "^2.10.24",
        "survos/core-bundle": "^2.10.19",
        "survos/crawler-bundle": "^2.10.19",
        "survos/deployment-bundle": "^2.10.19",
        "survos/elastic-bundle": "^2.24",
        "survos/ez-bundle": "^2.10.25",
        "survos/fetch-bundle": "^2.18",
        "survos/field-bundle": "^2.10.19",
        "survos/imgproxy-bundle": "^2.10.24",
        "survos/import-bundle": "^2.11.3",
        "survos/js-twig-bundle": ">=2.10.19",
        "survos/jsonl-bundle": "^2.10.19",
        "survos/kit-bundle": "^2.10.25",
        "survos/lingua-core": "^2.10.19",
        "survos/meili-bundle": "^2.10.24",
        "survos/omeka-bundle": "^2.10.19",
        "survos/schema-org-bundle": "^2.24",
        "survos/search-bundle": "^2.24",
        "survos/seo-bundle": "^2.10.19",
        "survos/state-bundle": "^2.11.4",
        "survos/storage-bundle": "^2.10.25",
        "survos/tabler-bundle": "^2.10.28",
        "survos/tui-extras-bundle": "^2.10.19",
        "survos/wordpress-bundle": "^2.24",
        "symfony/ai-bundle": "^0.8.0",
        "symfony/asset": "^8.1",
        "symfony/asset-mapper": "^8.1.1",
        "symfony/console": "^8.1.1",
        "symfony/doctrine-messenger": "^8.1.1",
        "symfony/dotenv": "^8.1",
        "symfony/expression-language": "^8.1.1",
        "symfony/flex": "^2.11.0",
        "symfony/form": "^8.1.1",
        "symfony/framework-bundle": "^8.1.1",
        "symfony/http-client": "^8.1.1",
        "symfony/intl": "^8.1.1",
        "symfony/lock": "^8.1.1",
        "symfony/mailer": "^8.1.1",
        "symfony/mcp-bundle": ">=0.10",
        "symfony/messenger": "^8.1.1",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/object-mapper": "^8.1.1",
        "symfony/process": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/security-bundle": "^8.1.1",
        "symfony/security-csrf": "^8.1",
        "symfony/serializer": "^8.1.1",
        "symfony/stimulus-bundle": "^3.2",
        "symfony/string": "^8.1",
        "symfony/translation": "^8.1.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/ux-chartjs": "^3.2",
        "symfony/ux-icons": "^3.2",
        "symfony/validator": "^8.1.1",
        "symfony/web-link": "^8.1",
        "symfony/workflow": "^8.1",
        "symfony/yaml": "^8.1.1",
        "symfonycasts/verify-email-bundle": "^1.18.0",
        "twig/extra-bundle": "^3.24.0",
        "twig/intl-extra": "^3.26",
        "twig/twig": "^3.27.1",
        "zenstruck/class-metadata": "^1.1.1"
    },
    "require-dev": {
        "dbrekelmans/bdi": "^1.4.1",
        "jawira/doctrine-diagram-bundle": "^2.0",
        "nette/php-generator": "^4.2.2",
        "nikic/php-parser": "^5.7",
        "phpmetrics/phpmetrics": "^2.9.1",
        "phpunit/phpunit": "^13.2.1",
        "survos/code-bundle": "^2.10.19",
        "survos/doc-bundle": "^2.10.19",
        "symfony/ai-mate": ">=0.10",
        "symfony/ai-symfony-mate-extension": ">=0.10",
        "symfony/browser-kit": "^8.1.1",
        "symfony/css-selector": "^8.1",
        "symfony/debug-bundle": "^8.1",
        "symfony/maker-bundle": "^1.67.0",
        "symfony/panther": "^2.4",
        "symfony/phpunit-bridge": "^8.1.1",
        "symfony/stopwatch": "^8.1",
        "symfony/web-profiler-bundle": "^8.1.1",
        "zenstruck/browser": "^1.10.1",
        "zenstruck/console-test": "^1.8"
    },
    "replace": {
        "paragonie/random_compat": "^2.0",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php56": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php71": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\Mate\\": "mate/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "endroid/installer": false,
            "php-http/discovery": true,
            "survos/installer": false,
            "symfony/ai-mate-composer-plugin": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "zenstruck/class-metadata": true
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true"
        },
        "ai-mate": {
            "extension": false,
            "scan-dirs": [
                "mate/src"
            ],
            "includes": [
                "mate/config.php"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear --no-warmup": "symfony-cmd",
            "fos:js-routing:dump --format=json --target=public/js/fos_js_routes.json": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "cache:clear": "symfony-cmd"
        },
        "coverage": "php -d xpcov.enabled=1 vendor/bin/phpunit --coverage-html coverage",
        "diagram": [
            "bin/console doctrine:diagram:er --filename=assets/er.svg --exclude=doctrine_migration_versions,messenger_messages",
            "bin/console doctrine:diagram:class --filename=assets/db.svg --exclude=doctrine_migration_versions,messenger_messages"
        ],
        "index": [
            "php -d memory_limit=512M bin/console grid:index --reset"
        ]
    }
}
